# Telegram (aiogram — run_bot.py или docker compose service bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# API (для /api/*; веб-страницы пока без проверки)
API_TOKEN=

# AI: DeepSeek (категории) + Gemini (чеки/фото) + Groq (Whisper, fallback)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_USE_LOCAL=false

# OCR (Tesseract, если используется вне vision)
OCR_LANG=rus+eng

# Yandex Calendar (CalDAV) — пароль приложения «Календарь»
YANDEX_CALDAV_USER=
YANDEX_CALDAV_APP_PASSWORD=
YANDEX_CALENDAR_URLS=
CALENDAR_SYNC_ENABLED=false

# Google Calendar — личный (секретный iCal URL из настроек календаря)
GOOGLE_CALENDAR_ICAL_URL=
GOOGLE_CALENDAR_SYNC_ENABLED=false

# SQLite (по умолчанию planner.db в корне проекта)
# DATABASE_URL=sqlite+aiosqlite:///./planner.db

# Роли моделей (адрес/ключ/модель — здесь, а не в коде)
AI_CATEGORIZE_BASE_URL=https://openrouter.ai/api/v1
AI_CATEGORIZE_API_KEY=
AI_CATEGORIZE_MODEL=z-ai/glm-5.3-flash
AI_VISION_BASE_URL=https://openrouter.ai/api/v1
AI_VISION_API_KEY=
AI_VISION_MODEL=google/gemini-3.6-flash
# Резервы (правило: где основной OpenRouter — резерв DeepSeek, и наоборот)
AI_TEXT_FALLBACK_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_FALLBACK_API_KEY=
AI_TEXT_FALLBACK_MODEL=deepseek-v4-pro
AI_VISION_FALLBACK_BASE_URL=https://api.deepseek.com/v1
AI_VISION_FALLBACK_API_KEY=
AI_VISION_FALLBACK_MODEL=deepseek-v4-flash-vision-exp
