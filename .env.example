# Telegram (aiogram — run_bot.py или docker compose service bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# API (для /api/*; веб-страницы пока без проверки)
API_TOKEN=

# AI: DeepSeek (категории) + Gemini (чеки/фото) + Groq (Whisper, fallback)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_USE_LOCAL=false

# OCR (Tesseract, если используется вне vision)
OCR_LANG=rus+eng

# Yandex Calendar (CalDAV) — пароль приложения «Календарь»
YANDEX_CALDAV_USER=
YANDEX_CALDAV_APP_PASSWORD=
YANDEX_CALENDAR_URLS=
CALENDAR_SYNC_ENABLED=false

# Google Calendar — личный (секретный iCal URL из настроек календаря)
GOOGLE_CALENDAR_ICAL_URL=
GOOGLE_CALENDAR_SYNC_ENABLED=false

# SQLite (по умолчанию planner.db в корне проекта)
# DATABASE_URL=sqlite+aiosqlite:///./planner.db
